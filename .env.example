# Public site origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=

# Supabase PostgreSQL (server only)
DATABASE_URL=

# Private Supabase Storage for paid eBook delivery (server only). The bucket
# must remain private; do not use a public object URL for the eBook PDF.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EBOOK_STORAGE_BUCKET=
EBOOK_STORAGE_OBJECT_PATH=

# Square: application and location identifiers are public by design; access token is server-only.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_API_VERSION=

# Server-only HMAC key for short-lived physical-book quote receipts.
QUOTE_SIGNING_SECRET=

# Lulu credentials and webhook signing configuration (server only).
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_API_ENVIRONMENT=
LULU_OAUTH_TOKEN_URL=
LULU_WEBHOOK_SECRET=
LULU_PRINT_JOB_LOOKUP_URL_TEMPLATE=

# Configure only after Lulu has supplied and approved each edition's POD package and production PDFs.
BOOK_PAPERBACK_PRICE_CENTS=
BOOK_PAPERBACK_LULU_POD_PACKAGE_ID=
BOOK_PAPERBACK_PAGE_COUNT=
BOOK_PAPERBACK_INTERIOR_PDF_URL=
BOOK_PAPERBACK_COVER_PDF_URL=
BOOK_HARDCOVER_PRICE_CENTS=
BOOK_HARDCOVER_LULU_POD_PACKAGE_ID=
BOOK_HARDCOVER_PAGE_COUNT=
BOOK_HARDCOVER_INTERIOR_PDF_URL=
BOOK_HARDCOVER_COVER_PDF_URL=

# Internal recovery endpoints. Never expose this value to the browser.
ADMIN_ORDER_RECOVERY_TOKEN=

# Optional order confirmation delivery via Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# CONTACT_EMAIL_API_KEY, CONTACT_RECIPIENT_EMAIL, and NEXT_PUBLIC_PLAUSIBLE_DOMAIN
# are intentionally not included: the current application does not use them.
